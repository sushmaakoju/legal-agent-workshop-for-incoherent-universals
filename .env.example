# Copy to .env and fill in your own Meta key. Never commit .env.
# No OpenAI key is needed. The SDK is only a client library;
# every call goes to https://api.meta.ai/v1, to a Muse model.
# The key is read from the environment only; it is never printed.
META_API_KEY=
# Fallback name used by the workshop setup, if you already use it:
# MODEL_API_KEY=
MODEL_NAME=muse-wonder-1.0
# If your key only has muse-spark-1.3 access, use that instead:
#MODEL_NAME=muse-spark-1.3
